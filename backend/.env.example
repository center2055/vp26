VP26_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost

# Schluessel, mit dem Anmeldungen verschluesselt werden. Ohne Eintrag legt das
# Backend beim ersten Start selbst einen an (backend/.vp26-session-key).
# Wird der Schluessel ersetzt, muessen sich alle Geraete neu anmelden.
VP26_SESSION_SECRET=

# Nur fuer den Eigenbetrieb: ein fester Zugang, der greift, solange sich niemand
# angemeldet hat. Im normalen Betrieb meldet sich jede Schule selbst an.
VP26_DEFAULT_SCHOOL_ID=
VP26_DEFAULT_USERNAME=
VP26_DEFAULT_PASSWORD=
VP26_DEFAULT_SERVER_DOMAIN=stundenplan24.de
VP26_DEFAULT_PORT=
